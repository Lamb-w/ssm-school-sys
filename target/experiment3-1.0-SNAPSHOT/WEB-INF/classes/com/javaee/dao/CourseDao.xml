<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaee.dao.CourseDao">
	<select id="findCourseById" parameterType="int" resultType="course">
		select * from Course where id = #{id}
	</select>
    <!-- 下面是带查询条件的分页查询  点击查询后将查询条件封装在course中，再将它和页号、页大小一起封装在map里。-->
    <select id="findCoursesByConditionPage" parameterType="map" resultType="course">
        select * from Course
		<where>			
			<if test="course != null">
				<if test="course.cNo !=null and course.cNo!=''">  <!-- 且：不能写成&& -->
					cNo like concat('%', #{course.cNo}, '%')
				</if>
				<if test="course.name !=null and course.name!=''"> <!-- 除第一个开头的and可省，下面的and不能省。 -->
					and name like concat('%', #{course.name}, '%')
				</if>	
				<if test="course.credit !=null and course.credit!='-1'">
					and credit=#{course.credit}
				</if>	
				<if test="course.classHour !=null and course.classHour!='-1'">
					and classHour=#{course.classHour}
				</if>			
			</if>								
		</where>        
        <if test="start!=null and size!=null">
            limit #{start}, #{size}
        </if>
    </select>
    
    <select id="getCoursesCountByConditionPage" parameterType="map" resultType="int">  <!-- 传入参数用map型而不是course，有利于将来将学分、学时设成区间来查询 -->
    	select count(*) from Course
		<where>
			<if test="course != null">
				<if test="course.cNo !=null and course.cNo!=''">  <!-- 且：不能写成&& -->
					cNo like concat('%', #{course.cNo}, '%')
				</if>
				<if test="course.name !=null and course.name!=''"> <!-- 除第一个开头的and可省，下面的and不能省。 -->
					and name like concat('%', #{course.name}, '%')
				</if>	
				<if test="course.credit !=null and course.credit!='-1'">
					and credit=#{course.credit}
				</if>	
				<if test="course.classHour !=null and course.classHour!='-1'">
					and classHour=#{course.classHour}
				</if>			
			</if>
		</where>
    </select>	
    <select id="getCredits" resultType="int"> <!-- 得到学分列表信息(现有课程有多少种学分，肯定要去掉重复的)  在select子句中用distinct即可去掉重复的行-->
    	select distinct credit from Course order by 1
    </select>  
    <select id="getClassHours" resultType="int"> <!-- 得到学时列表信息-->
    	select distinct classHour from Course order by 1
    </select>     
	<select id="getSameCount" parameterType="fieldExistValidVO" resultType="int">
		select count(*) from Course
		<where>
			<choose>
				<when test='"1" == fieldType'>
					cNo=#{fieldValue}
				</when>
				<otherwise> <!-- 能执行到这说明，前面的when都不满足 -->
					
				</otherwise>		
			</choose>	
		</where>
	</select>	
    	
	<insert id="insertCourse" parameterType="course">
		insert into Course(cNo, name, credit, classHour, memo) values(#{cNo}, #{name}, #{credit}, #{classHour}, #{memo})
	</insert>	
	<update id="updateCourse" parameterType="course">
		update Course
		set name=#{name}, credit=#{credit}, classHour=#{classHour}, memo=#{memo}
		where id = #{id}
	</update>
	<delete id="deleteCourse" parameterType="int">
		delete from Course where id = #{id}
	</delete>	
</mapper>